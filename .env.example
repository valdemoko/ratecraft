# ── Site ────────────────────────────────────────────────────────────────
# Canonical production URL (no trailing slash). Used for metadata,
# canonical tags, sitemap and structured data.
# REQUIRED in production: without it the site serves noindex + localhost canonicals.
NEXT_PUBLIC_SITE_URL=https://ratecraft.site

# ── Analytics (optional, fill only when you actually use them) ─────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google AdSense (optional, OFF by default) ──────────────────────────
# Your AdSense publisher ID, e.g. ca-pub-1234567890123456
# Leave empty to disable all ad slots. Ads are never shown with an empty ID.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Master switch: set to "on" to render ad slots at all.
NEXT_PUBLIC_ADSENSE_ENABLED=off
